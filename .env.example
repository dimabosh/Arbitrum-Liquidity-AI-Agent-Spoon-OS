# Arbitrum Liquidity Agent Configuration
# Copy this file to .env and fill in your values

# === Server Configuration ===
PORT=8080
NEXT_PUBLIC_SITE_URL=http://localhost:8080

# === OpenRouter API Configuration ===
# Multi-model LLM access (Claude, GPT-4, Gemini, Llama, etc.)
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# === Arbitrum Network Configuration ===
# Public RPC (free but may be slower)
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc

# Or use a premium provider for better performance:
# ARBITRUM_RPC_URL=https://arb-mainnet.g.alchemy.com/v2/YOUR-API-KEY
# ARBITRUM_RPC_URL=https://arbitrum-mainnet.infura.io/v3/YOUR-API-KEY

# === Optional: Default Agent Settings ===
# Users can override these in the UI
LLM_PROVIDER=openrouter
MODEL_NAME=anthropic/claude-3.5-sonnet
STRATEGY_TYPE=yield

# === Logging ===
LOG_LEVEL=INFO  # Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
