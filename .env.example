# Spoon OS Configuration
# Copy this file to .env and fill in your values

# === LLM Provider API Keys ===
# At least one LLM provider key is required

# OpenAI (recommended)
OPENAI_API_KEY=your-openai-api-key-here

# Anthropic Claude
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Google Gemini
GEMINI_API_KEY=your-gemini-api-key-here

# DeepSeek
DEEPSEEK_API_KEY=your-deepseek-api-key-here

# OpenRouter (multi-model access)
OPENROUTER_API_KEY=your-openrouter-api-key-here

# === LLM Configuration ===
DEFAULT_LLM_PROVIDER=openai
DEFAULT_MODEL=gpt-4-turbo-preview

# === Arbitrum Network Configuration ===
# Arbitrum One RPC URL
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
# Or use a paid provider for better performance:
# ARBITRUM_RPC_URL=https://arb-mainnet.g.alchemy.com/v2/YOUR-API-KEY

# === Wallet Configuration ===
# Your wallet address for position queries
WALLET_ADDRESS=0xYourWalletAddressHere

# Signer configuration for transaction execution
SIGNER_TYPE=auto  # Options: auto, private_key, ledger, trezor
# If using private_key:
# PRIVATE_KEY=your-private-key-here  # WARNING: Keep this secure!

# === EVM Provider (alternative to ARBITRUM_RPC_URL) ===
EVM_PROVIDER_URL=https://arb1.arbitrum.io/rpc

# === Optional: Data Provider APIs ===
# For enhanced pool data and market analysis
# THE_GRAPH_API_KEY=your-graph-api-key-here
# DUNE_API_KEY=your-dune-api-key-here

# === Optional: Price Feeds ===
# COINGECKO_API_KEY=your-coingecko-api-key-here
# COINMARKETCAP_API_KEY=your-cmc-api-key-here

# === Gas Configuration ===
# Maximum gas price in gwei (optional)
# MAX_GAS_PRICE=50

# === Slippage Configuration ===
# Default slippage tolerance in percent
# DEFAULT_SLIPPAGE=0.5

# === Logging ===
LOG_LEVEL=INFO  # Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
